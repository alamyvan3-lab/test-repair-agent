# Copy to .env and fill in. Never commit .env.

# Nebius Token Factory API key (https://tokenfactory.nebius.com -> API keys).
TOKEN_FACTORY_API_KEY=

# OpenAI-compatible base URL, from https://docs.tokenfactory.nebius.com/quickstart
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Model IDs per role. Left blank on purpose: they will be filled from a live
# GET /v1/models call with your key (Phase 0), not guessed.
# Ultra role: fault diagnosis + patch generation.
MODEL_ULTRA=
# Nano/Super role: log triage, test-output summary, patch-sanity check.
MODEL_NANO=

# Copy to .env and fill in. Never commit .env.

# --- Nebius Token Factory -----------------------------------------------------
# API key: https://tokenfactory.nebius.com (API keys). Stays server-side; never sent to the browser.
TOKEN_FACTORY_API_KEY=
# OpenAI-compatible base URL (docs.tokenfactory.nebius.com/quickstart).
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Optional per-role overrides, e.g. if a model is only listed at a regional endpoint such as
# https://api.tokenfactory.us-central1.nebius.com/v1/ (used in Nebius's Nemotron cookbook).
ULTRA_BASE_URL=
NANO_BASE_URL=

# Model IDs per role. These were copied from the public Token Factory model catalog
# (tokenfactory.nebius.com/model-catalog, read 2026-10-12). They have NOT been checked
# against a live /v1/models listing yet. Run `python scripts/hello_tokenfactory.py`
# to list what your key can access, and correct these if they differ.
# Ultra role: fault diagnosis + patch generation (hard reasoning).
MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b
# Nano role: log triage, test-output summary, patch-sanity checks (fast, cheap).
# nvidia/nemotron-3-super-120b-a12b also works for this role.
MODEL_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# Sampling. Keep Ultra at 0-0.2 for patch generation.
ULTRA_TEMPERATURE=0.1
NANO_TEMPERATURE=0.0
ULTRA_MAX_TOKENS=8192
NANO_MAX_TOKENS=2048
# Optional JSON passed as extra_body, e.g. reasoning switches if the model supports them.
ULTRA_EXTRA_BODY=
NANO_EXTRA_BODY=

# Prices in USD per 1M tokens, used only for cost columns in reports. Values from the
# public model catalog (2026-10-12; currency assumed USD). Leave blank to report "n/a".
PRICE_ULTRA_IN_PER_M=1
PRICE_ULTRA_OUT_PER_M=3
PRICE_NANO_IN_PER_M=0.06
PRICE_NANO_OUT_PER_M=0.24

# --- Agent limits -----------------------------------------------------------------
MAX_ATTEMPTS=5
MAX_CORRECTIONS=2
MAX_TOTAL_TOKENS=250000
MAX_RUN_SECONDS=900
MAX_DIFF_LINES=60
TOP_K_FILES=4
MAX_FILE_CHARS=12000
SANITY_CHECK=true
LLM_TIMEOUT_S=180
LLM_MAX_RETRIES=3

# --- Techniques (README "Techniques and sources"); turn off one at a time for ablations ---
# Parallel Ultra candidates per attempt, merged by normalized-AST vote and ranked by tests.
CANDIDATES=3
# One temperature per candidate, kept within 0-0.2 for patch generation.
CANDIDATE_TEMPERATURES=0.0,0.1,0.2
# Spectrum-based fault localization (Ochiai) from per-test line coverage.
SBFL=true
# Rerun failing tests on their own (long tracebacks + locals) to spot shared-state bugs.
ISOLATION_RERUN=true
# After a fix, drop change regions the tests do not need (1-minimal, delta-debugging style).
MINIMIZE_PATCH=true
MINIMIZE_MAX_RUNS=8
# Ask Nano for response_format=json_object; falls back automatically if a model rejects it.
NANO_JSON_MODE=true

# --- Sandbox ------------------------------------------------------------------------
# docker (default, strong isolation) | local (subprocess, weaker) | auto
SANDBOX_BACKEND=docker
SANDBOX_IMAGE=test-repair-sandbox:latest
TEST_TIMEOUT_S=60
SANDBOX_MEMORY=512m
SANDBOX_CPUS=1
SANDBOX_PIDS=128
MAX_OUTPUT_BYTES=64000

# --- Web demo -------------------------------------------------------------------------
# Uploads also require SANDBOX_BACKEND=docker.
ALLOW_UPLOADS=false
MAX_UPLOAD_BYTES=1000000
MAX_UPLOAD_FILES=200
RATE_LIMIT_RUNS=5
RATE_LIMIT_WINDOW_S=600
MAX_CONCURRENT_RUNS=2
TRUST_PROXY_HEADERS=false
